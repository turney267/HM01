<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application>

        <!--
            Captive No-URL-Bar Intent & Custom Tabs Browser Activity.
            Intentionally omits CATEGORY_LAUNCHER so no home screen icon is shown.
        -->
        <activity
            android:name="dev.hm01.browser.IntentBrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:scheme="http" />
            </intent-filter>
        </activity>

        <!--
            Minimal Custom Tabs Service for OAuth / OIDC / AppAuth / Slack / Banking compatibility.
        -->
        <service
            android:name="dev.hm01.browser.MinimalCustomTabsService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.action.CustomTabsService" />
            </intent-filter>
        </service>

    </application>

</manifest>
